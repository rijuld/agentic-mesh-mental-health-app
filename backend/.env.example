# Digital Ocean Gradient AI Configuration
GRADIENT_AI_API_KEY=your_gradient_ai_api_key_here
GRADIENT_AI_WORKSPACE_ID=your_workspace_id_here
GRADIENT_AI_BASE_URL=https://api.gradient.ai/api

# Agent IDs from Digital Ocean Gradient AI
AGENT_ID_PATIENT_DBT=your_patient_agent_id
AGENT_ID_ALLY=your_ally_agent_id
AGENT_ID_THERAPIST=your_therapist_agent_id
AGENT_ID_CRISIS=your_crisis_agent_id
AGENT_ID_MENTALIZATION=your_mentalization_agent_id

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bpd_app

# JWT Secret
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
APP_ENV=development
DEBUG=true
